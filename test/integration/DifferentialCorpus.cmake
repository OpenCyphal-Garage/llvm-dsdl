# The pair of generated C trees the differential lanes measure and compare.
#
# Two lanes need the same corpus: the parity lane, which checks that the wire
# images agree, and the instruction-count comparison, which counts what each
# implementation executes to produce them. Both need the same ten types
# generated by both compilers, the same two case tables compiled against them,
# and the same guarantee that a missing header is an error rather than a case
# that quietly stops being exercised. This is that step, once.
#
# Nunavut is a pinned peer implementation used for corroboration, not an oracle;
# RunDifferentialParity.cmake carries the authority hierarchy.
#
# include() this from a script-mode runner that has already validated and set:
# DSDLC, UAVCAN_ROOT, C_COMPILER, PYTHON_EXECUTABLE, SOURCE_ROOT, NUNAVUT_REPO,
# PYDSDL_REPO.

# The ten cases, as nine definitions: ExecuteCommand contributes a request and a
# response. Every wire-shape class is here -- see RunDifferentialParity.cmake.
set(LLVMDSDL_DIFFERENTIAL_DEFINITIONS
    "node/7509.Heartbeat.1.0.dsdl"
    "node/435.ExecuteCommand.1.3.dsdl"
    "register/Value.1.0.dsdl"
    "metatransport/can/Frame.0.2.dsdl"
    "primitive/array/Real32.1.0.dsdl"
    "node/port/SubjectIDList.1.0.dsdl"
    "pnp/8165.NodeIDAllocationData.2.0.dsdl"
    "diagnostic/8184.Record.1.1.dsdl"
    "time/SynchronizedTimestamp.1.0.dsdl")

# Warnings are errors for both sides: the case tables name every generated entry
# point, so a signature that drifts has to fail here rather than at a mismatch
# nobody can attribute.
set(LLVMDSDL_DIFFERENTIAL_BASE_C_FLAGS -std=c11 -Wall -Wextra -Werror)

## Names the nine headers of a generated tree the way the case table template
## reads them, and lists them in LLVMDSDL_DIFFERENTIAL_OURS_HEADERS.
##
## A macro rather than a function: the template substitutes these by name, so
## they have to land in the caller's scope. The obj backend publishes the same
## headers as the C backend, which is what lets one template serve both.
macro(llvmdsdl_differential_ours_headers root)
  set(OURS_HEARTBEAT_HEADER "${root}/uavcan/node/Heartbeat_1_0.h")
  set(OURS_EXECUTECOMMAND_HEADER "${root}/uavcan/node/ExecuteCommand_1_3.h")
  set(OURS_VALUE_HEADER "${root}/uavcan/register/Value_1_0.h")
  set(OURS_FRAME_HEADER "${root}/uavcan/metatransport/can/Frame_0_2.h")
  set(OURS_REAL32_HEADER "${root}/uavcan/primitive/array/Real32_1_0.h")
  set(OURS_SUBJECTIDLIST_HEADER "${root}/uavcan/node/port/SubjectIDList_1_0.h")
  set(OURS_NODEIDALLOC_HEADER "${root}/uavcan/pnp/NodeIDAllocationData_2_0.h")
  set(OURS_DIAGRECORD_HEADER "${root}/uavcan/diagnostic/Record_1_1.h")
  set(OURS_SYNCTIMESTAMP_HEADER "${root}/uavcan/time/SynchronizedTimestamp_1_0.h")
  set(LLVMDSDL_DIFFERENTIAL_OURS_HEADERS
      "${OURS_HEARTBEAT_HEADER}"
      "${OURS_EXECUTECOMMAND_HEADER}"
      "${OURS_VALUE_HEADER}"
      "${OURS_FRAME_HEADER}"
      "${OURS_REAL32_HEADER}"
      "${OURS_SUBJECTIDLIST_HEADER}"
      "${OURS_NODEIDALLOC_HEADER}"
      "${OURS_DIAGRECORD_HEADER}"
      "${OURS_SYNCTIMESTAMP_HEADER}")
endmacro()

## Generates both C trees under OUT_DIR and compiles everything the drivers link
## against.
##
## OUT_DIR is owned by this function and wiped on entry, so write nothing there
## before calling it.
##
## Arguments:
##   OUT_DIR          -- directory to generate and build in.
##   DSDLC_EXTRA_ARGS -- extra arguments for this project's generator.
##   EXTRA_C_FLAGS    -- appended to the base flags for every unit compiled here.
##   OBJECTS_VAR      -- name of the variable to receive the object list.
##   BUILD_DIR_VAR    -- name of the variable to receive the build directory.
##   NUNAVUT_OBJECT_VAR -- name of the variable to receive the peer's case table,
##                       which a second driver against the same peer links too.
##   OURS_DIR_VAR     -- name of the variable to receive this project's tree.
##   NUNAVUT_DIR_VAR  -- name of the variable to receive the peer's tree.
function(llvmdsdl_differential_corpus)
  cmake_parse_arguments(PARSE_ARGV 0 ARG ""
      "OUT_DIR;OBJECTS_VAR;BUILD_DIR_VAR;OURS_DIR_VAR;NUNAVUT_DIR_VAR;NUNAVUT_OBJECT_VAR"
      "DSDLC_EXTRA_ARGS;EXTRA_C_FLAGS")

  foreach(required OUT_DIR OBJECTS_VAR)
    if(NOT DEFINED ARG_${required} OR "${ARG_${required}}" STREQUAL "")
      message(FATAL_ERROR "llvmdsdl_differential_corpus: missing ${required}")
    endif()
  endforeach()

  set(ours_template "${SOURCE_ROOT}/test/integration/DifferentialParityOurs.c.in")
  set(nv_template "${SOURCE_ROOT}/test/integration/DifferentialParityNunavut.c.in")
  set(abi_header "${SOURCE_ROOT}/test/integration/DifferentialParityABI.h")
  foreach(path "${ours_template}" "${nv_template}" "${abi_header}")
    if(NOT EXISTS "${path}")
      message(FATAL_ERROR "Differential harness input missing: ${path}")
    endif()
  endforeach()

  file(REMOVE_RECURSE "${ARG_OUT_DIR}")
  file(MAKE_DIRECTORY "${ARG_OUT_DIR}")
  set(ours_out "${ARG_OUT_DIR}/ours")
  set(dsdl_out "${ARG_OUT_DIR}/nunavut")
  set(build_out "${ARG_OUT_DIR}/build")
  file(MAKE_DIRECTORY "${ours_out}")
  file(MAKE_DIRECTORY "${dsdl_out}")
  file(MAKE_DIRECTORY "${build_out}")

  execute_process(
    COMMAND
      "${DSDLC}" --target-language c
        "${UAVCAN_ROOT}"
        ${ARG_DSDLC_EXTRA_ARGS}
        --outdir "${ours_out}"
    RESULT_VARIABLE ours_result
    OUTPUT_VARIABLE ours_stdout
    ERROR_VARIABLE ours_stderr
  )
  if(NOT ours_result EQUAL 0)
    message(STATUS "dsdlc stdout:\n${ours_stdout}")
    message(STATUS "dsdlc stderr:\n${ours_stderr}")
    message(FATAL_ERROR "failed to generate llvm-dsdl C output")
  endif()

  set(definition_arguments "")
  foreach(definition IN LISTS LLVMDSDL_DIFFERENTIAL_DEFINITIONS)
    list(APPEND definition_arguments "${UAVCAN_ROOT}:${definition}")
  endforeach()

  set(pythonpath "${PYDSDL_REPO}:${NUNAVUT_REPO}/src")
  execute_process(
    COMMAND
      "${CMAKE_COMMAND}" -E env "PYTHONPATH=${pythonpath}"
        "${PYTHON_EXECUTABLE}" -m nunavut
        --jobs 1
        --target-language c
        --outdir "${dsdl_out}"
        --lookup-dir "${UAVCAN_ROOT}"
        ${definition_arguments}
    RESULT_VARIABLE nunavut_result
    OUTPUT_VARIABLE nunavut_stdout
    ERROR_VARIABLE nunavut_stderr
  )
  if(NOT nunavut_result EQUAL 0)
    message(STATUS "nunavut stdout:\n${nunavut_stdout}")
    message(STATUS "nunavut stderr:\n${nunavut_stderr}")
    message(FATAL_ERROR "failed to generate nunavut reference C output")
  endif()

  # The bytes are compared by the harness this corpus builds; the constants the two headers declare
  # beside them are compared here, because nothing a round-trip does would show a disagreement.
  execute_process(
    COMMAND
      "${PYTHON_EXECUTABLE}"
        "${SOURCE_ROOT}/test/integration/compare_generated_constants.py"
        "${ours_out}"
        "${dsdl_out}"
    RESULT_VARIABLE constants_result
    OUTPUT_VARIABLE constants_stdout
    ERROR_VARIABLE constants_stderr
  )
  message(STATUS "${constants_stdout}")
  if(NOT constants_result EQUAL 0)
    message(STATUS "${constants_stderr}")
    message(FATAL_ERROR "the two generators disagree on the constants they declare")
  endif()

  llvmdsdl_differential_ours_headers("${ours_out}")

  set(NV_HEARTBEAT_HEADER "${dsdl_out}/uavcan/node/Heartbeat_1_0.h")
  set(NV_EXECUTECOMMAND_HEADER "${dsdl_out}/uavcan/node/ExecuteCommand_1_3.h")
  set(NV_VALUE_HEADER "${dsdl_out}/uavcan/_register/Value_1_0.h")
  set(NV_FRAME_HEADER "${dsdl_out}/uavcan/metatransport/can/Frame_0_2.h")
  set(NV_REAL32_HEADER "${dsdl_out}/uavcan/primitive/array/Real32_1_0.h")
  set(NV_SUBJECTIDLIST_HEADER "${dsdl_out}/uavcan/node/port/SubjectIDList_1_0.h")
  set(NV_NODEIDALLOC_HEADER "${dsdl_out}/uavcan/pnp/NodeIDAllocationData_2_0.h")
  set(NV_DIAGRECORD_HEADER "${dsdl_out}/uavcan/diagnostic/Record_1_1.h")
  set(NV_SYNCTIMESTAMP_HEADER "${dsdl_out}/uavcan/time/SynchronizedTimestamp_1_0.h")

  foreach(header
      ${LLVMDSDL_DIFFERENTIAL_OURS_HEADERS}
      "${NV_HEARTBEAT_HEADER}"
      "${NV_EXECUTECOMMAND_HEADER}"
      "${NV_VALUE_HEADER}"
      "${NV_FRAME_HEADER}"
      "${NV_REAL32_HEADER}"
      "${NV_SUBJECTIDLIST_HEADER}"
      "${NV_NODEIDALLOC_HEADER}"
      "${NV_DIAGRECORD_HEADER}"
      "${NV_SYNCTIMESTAMP_HEADER}")
    if(NOT EXISTS "${header}")
      message(FATAL_ERROR "expected generated header missing: ${header}")
    endif()
  endforeach()

  set(ours_case_c "${build_out}/differential_ours.c")
  set(nv_case_c "${build_out}/differential_nunavut.c")
  configure_file("${ours_template}" "${ours_case_c}" @ONLY)
  configure_file("${nv_template}" "${nv_case_c}" @ONLY)

  file(GLOB_RECURSE ours_c_sources "${ours_out}/*.c")
  list(LENGTH ours_c_sources ours_c_count)
  if(ours_c_count EQUAL 0)
    message(FATAL_ERROR "no generated llvm-dsdl C implementation files under ${ours_out}")
  endif()

  set(flags ${LLVMDSDL_DIFFERENTIAL_BASE_C_FLAGS} ${ARG_EXTRA_C_FLAGS})
  set(objects "")

  set(ours_case_obj "${build_out}/differential_ours.o")
  execute_process(
    COMMAND
      "${C_COMPILER}"
        ${flags}
        -I "${SOURCE_ROOT}/test/integration"
        -I "${ours_out}"
        -c "${ours_case_c}"
        -o "${ours_case_obj}"
    RESULT_VARIABLE cc_result
    OUTPUT_VARIABLE cc_stdout
    ERROR_VARIABLE cc_stderr
  )
  if(NOT cc_result EQUAL 0)
    message(STATUS "compiler stdout:\n${cc_stdout}")
    message(STATUS "compiler stderr:\n${cc_stderr}")
    message(FATAL_ERROR "failed to compile the llvm-dsdl case table")
  endif()
  list(APPEND objects "${ours_case_obj}")

  set(nv_case_obj "${build_out}/differential_nunavut.o")
  execute_process(
    COMMAND
      "${C_COMPILER}"
        ${flags}
        -I "${SOURCE_ROOT}/test/integration"
        -I "${dsdl_out}"
        -c "${nv_case_c}"
        -o "${nv_case_obj}"
    RESULT_VARIABLE cc_result
    OUTPUT_VARIABLE cc_stdout
    ERROR_VARIABLE cc_stderr
  )
  if(NOT cc_result EQUAL 0)
    message(STATUS "compiler stdout:\n${cc_stdout}")
    message(STATUS "compiler stderr:\n${cc_stderr}")
    message(FATAL_ERROR "failed to compile the nunavut case table")
  endif()
  list(APPEND objects "${nv_case_obj}")

  set(generated_obj_dir "${build_out}/generated-obj")
  file(MAKE_DIRECTORY "${generated_obj_dir}")
  set(index 0)
  foreach(src IN LISTS ours_c_sources)
    math(EXPR index "${index} + 1")
    set(obj "${generated_obj_dir}/generated_${index}.o")
    execute_process(
      COMMAND
        "${C_COMPILER}"
          ${flags}
          -I "${ours_out}"
          -c "${src}"
          -o "${obj}"
      RESULT_VARIABLE cc_result
      OUTPUT_VARIABLE cc_stdout
      ERROR_VARIABLE cc_stderr
    )
    if(NOT cc_result EQUAL 0)
      message(STATUS "failed source: ${src}")
      message(STATUS "compiler stdout:\n${cc_stdout}")
      message(STATUS "compiler stderr:\n${cc_stderr}")
      message(FATAL_ERROR "failed to compile generated llvm-dsdl C implementation")
    endif()
    list(APPEND objects "${obj}")
  endforeach()

  set(${ARG_OBJECTS_VAR} "${objects}" PARENT_SCOPE)
  if(DEFINED ARG_BUILD_DIR_VAR AND NOT "${ARG_BUILD_DIR_VAR}" STREQUAL "")
    set(${ARG_BUILD_DIR_VAR} "${build_out}" PARENT_SCOPE)
  endif()
  if(DEFINED ARG_OURS_DIR_VAR AND NOT "${ARG_OURS_DIR_VAR}" STREQUAL "")
    set(${ARG_OURS_DIR_VAR} "${ours_out}" PARENT_SCOPE)
  endif()
  if(DEFINED ARG_NUNAVUT_DIR_VAR AND NOT "${ARG_NUNAVUT_DIR_VAR}" STREQUAL "")
    set(${ARG_NUNAVUT_DIR_VAR} "${dsdl_out}" PARENT_SCOPE)
  endif()
  if(DEFINED ARG_NUNAVUT_OBJECT_VAR AND NOT "${ARG_NUNAVUT_OBJECT_VAR}" STREQUAL "")
    set(${ARG_NUNAVUT_OBJECT_VAR} "${nv_case_obj}" PARENT_SCOPE)
  endif()
endfunction()

## Generates the same types as objects, straight from dsdlc, and compiles the
## case table against the headers they publish.
##
## Call this after llvmdsdl_differential_corpus, which owns OUT_DIR and wipes it.
##
## The objects define the same entry points the compiled C defines, so they
## cannot be linked beside it; a driver that wants both implementations links one
## binary per implementation. dsdlc runs its own LLVM pipeline at O2 here, so
## what this produces is comparable with C compiled at -O2 and is not affected by
## EXTRA_C_FLAGS, which reach only the case table.
##
## Arguments:
##   OUT_DIR       -- the corpus directory llvmdsdl_differential_corpus was given.
##   OBJECTS_VAR   -- name of the variable to receive the object list.
##   OBJ_DIR_VAR   -- name of the variable to receive the generated tree.
##   DSDLC_EXTRA_ARGS, EXTRA_C_FLAGS -- as above.
function(llvmdsdl_differential_obj_corpus)
  cmake_parse_arguments(PARSE_ARGV 0 ARG ""
      "OUT_DIR;OBJECTS_VAR;OBJ_DIR_VAR"
      "DSDLC_EXTRA_ARGS;EXTRA_C_FLAGS")

  foreach(required OUT_DIR OBJECTS_VAR)
    if(NOT DEFINED ARG_${required} OR "${ARG_${required}}" STREQUAL "")
      message(FATAL_ERROR "llvmdsdl_differential_obj_corpus: missing ${required}")
    endif()
  endforeach()

  set(ours_template "${SOURCE_ROOT}/test/integration/DifferentialParityOurs.c.in")
  set(obj_out "${ARG_OUT_DIR}/obj")
  set(build_out "${ARG_OUT_DIR}/build")
  file(MAKE_DIRECTORY "${obj_out}")

  execute_process(
    COMMAND
      "${DSDLC}" --target-language obj
        "${UAVCAN_ROOT}"
        ${ARG_DSDLC_EXTRA_ARGS}
        --outdir "${obj_out}"
    RESULT_VARIABLE obj_result
    OUTPUT_VARIABLE obj_stdout
    ERROR_VARIABLE obj_stderr
  )
  if(NOT obj_result EQUAL 0)
    message(STATUS "dsdlc stdout:\n${obj_stdout}")
    message(STATUS "dsdlc stderr:\n${obj_stderr}")
    message(FATAL_ERROR "failed to generate llvm-dsdl object output")
  endif()

  llvmdsdl_differential_ours_headers("${obj_out}")
  foreach(header ${LLVMDSDL_DIFFERENTIAL_OURS_HEADERS})
    if(NOT EXISTS "${header}")
      message(FATAL_ERROR "expected generated header missing: ${header}")
    endif()
  endforeach()

  file(GLOB_RECURSE emitted_objects "${obj_out}/*.o")
  list(LENGTH emitted_objects emitted_count)
  if(emitted_count EQUAL 0)
    message(FATAL_ERROR "no objects under ${obj_out}")
  endif()

  set(obj_case_c "${build_out}/differential_obj.c")
  configure_file("${ours_template}" "${obj_case_c}" @ONLY)

  set(obj_case_obj "${build_out}/differential_obj.o")
  execute_process(
    COMMAND
      "${C_COMPILER}"
        ${LLVMDSDL_DIFFERENTIAL_BASE_C_FLAGS}
        ${ARG_EXTRA_C_FLAGS}
        -I "${SOURCE_ROOT}/test/integration"
        -I "${obj_out}"
        -c "${obj_case_c}"
        -o "${obj_case_obj}"
    RESULT_VARIABLE cc_result
    OUTPUT_VARIABLE cc_stdout
    ERROR_VARIABLE cc_stderr
  )
  if(NOT cc_result EQUAL 0)
    message(STATUS "compiler stdout:\n${cc_stdout}")
    message(STATUS "compiler stderr:\n${cc_stderr}")
    message(FATAL_ERROR "failed to compile the object-backend case table")
  endif()

  set(${ARG_OBJECTS_VAR} "${obj_case_obj};${emitted_objects}" PARENT_SCOPE)
  if(DEFINED ARG_OBJ_DIR_VAR AND NOT "${ARG_OBJ_DIR_VAR}" STREQUAL "")
    set(${ARG_OBJ_DIR_VAR} "${obj_out}" PARENT_SCOPE)
  endif()
endfunction()
