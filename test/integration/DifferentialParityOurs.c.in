static int8_t oursHeartbeatSerialize(const void *const obj, uint8_t *const buffer,
                                     size_t *const inoutSize) {
  return uavcan__node__Heartbeat__serialize_((const uavcan__node__Heartbeat *)obj,
                                             buffer, inoutSize);
}
static int8_t oursHeartbeatDeserialize(void *const outObj,
                                       const uint8_t *const buffer,
                                       size_t *const inoutSize) {
  return uavcan__node__Heartbeat__deserialize_((uavcan__node__Heartbeat *)outObj,
                                               buffer, inoutSize);
}

