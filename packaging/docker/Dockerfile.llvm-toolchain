# The musl flavour of the LLVM/MLIR toolchain llvm-dsdl links against.
#
# Why we build it at all: a distribution's LLVM fixes decisions that are ours
# to make -- the glibc floor, the C++ standard library, RTTI, whether a shared
# libLLVM exists. Static linking against apt.llvm.org or Homebrew is not
# reachable by build flag, because their MLIR exports name a target declared
# SHARED. See section 1 of docs/development/distribution-channels.md.
#
# This flavour serves the `bin` component: a static musl binary has no glibc
# floor, so one .deb per architecture installs across Debian and Ubuntu alike.
# The glibc flavour, for llvm-dsdl-dev and the CI toolshed, is
# Dockerfile.llvm-toolchain-glibc. The CMake configuration is shared between
# them by packaging/toolchain/build_llvm.py; a flag that drifts between the two
# would produce toolchains that are not the same toolchain.
#
# Alpine rather than a musl sysroot on Ubuntu: musl is native here, so the two
# architectures that matter build on native runners with no cross-compilation.
#
# Build:
#   docker build -f packaging/docker/Dockerfile.llvm-toolchain \
#     --build-arg LLVM_REF="$(grep -v '^#' packaging/toolchain/llvm.pin | tr -d '[:space:]')" \
#     -t llvm-dsdl-toolchain:musl .

ARG ALPINE_VERSION=3.24

FROM alpine:${ALPINE_VERSION} AS build

ARG LLVM_REF
ARG BUILD_JOBS=0

RUN test -n "${LLVM_REF}" || (echo "LLVM_REF is required; see packaging/toolchain/llvm.pin" >&2; exit 1)

RUN apk add --no-cache build-base cmake ninja git python3 linux-headers

WORKDIR /work

# Shallow clone at the tag: the full history is several GB and is never needed.
RUN git clone --depth 1 --branch "${LLVM_REF}" \
        https://github.com/llvm/llvm-project.git llvm-project

COPY packaging/toolchain/build_llvm.py /work/build_llvm.py
RUN python3 /work/build_llvm.py \
        --source /work/llvm-project \
        --llvm-ref "${LLVM_REF}" \
        --jobs "${BUILD_JOBS}"

# The final image carries the install prefix and a compiler, not the build tree.
FROM alpine:${ALPINE_VERSION}

ARG LLVM_REF
LABEL org.opencontainers.image.title="llvm-dsdl LLVM/MLIR toolchain (musl)"
LABEL org.opencontainers.image.description="Static LLVM/MLIR ${LLVM_REF}, seven target backends, musl"

RUN apk add --no-cache build-base cmake ninja git python3 py3-pip

# lit is required, not optional. LLVM installs FileCheck and not (via
# LLVM_INSTALL_UTILS) but never installs lit itself, and test/lit/CMakeLists.txt
# reacts to a missing lit with a WARNING and an early return -- the suite would
# report green having run nothing. Alpine's Python is externally managed, hence
# --break-system-packages; this is a single-purpose image with no environment
# to protect.
RUN pip install --no-cache-dir --break-system-packages lit

COPY --from=build /opt/llvm-dsdl-toolchain /opt/llvm-dsdl-toolchain

ENV LLVM_DIR=/opt/llvm-dsdl-toolchain/lib/cmake/llvm \
    MLIR_DIR=/opt/llvm-dsdl-toolchain/lib/cmake/mlir \
    CMAKE_PREFIX_PATH=/opt/llvm-dsdl-toolchain \
    PATH=/opt/llvm-dsdl-toolchain/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /src
