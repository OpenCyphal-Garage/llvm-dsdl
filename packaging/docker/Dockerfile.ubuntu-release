# Build environment for the downloadable Ubuntu .deb.
#
# Ubuntu 22.04 is the oldest release we support, so building here sets the glibc
# floor at 2.35 and the resulting package installs on 22.04, 24.04, and 26.04
# alike. This deliberately is NOT the CI toolshed image: that one is Ubuntu
# 26.04, and a .deb built against its glibc would refuse to install on anything
# older.
#
# LLVM/MLIR comes from our own toolchain image rather than apt.llvm.org. That is
# the whole point of building it: a distribution's LLVM fixes the glibc floor,
# the C++ standard library, RTTI, and whether a shared libLLVM exists at all.
# Ours is static and carries no optional-feature dependencies, so nothing has to
# be vendored into the package -- see section 1 of
# docs/development/distribution-channels.md.
#
# apt.llvm.org is still used, for clang alone. jammy's GCC 11 predates much of
# C++23 and the project requires it. Taking a *compiler* from them is not the
# thing we were trying to stop doing; taking their *libraries* was, because
# those are what decided the floor, the stdlib and the dylib on our behalf.
#
# apt.kitware.com supplies CMake >= 3.24 (jammy has 3.22).

ARG TOOLCHAIN_IMAGE=ghcr.io/opencyphal-garage/llvm-dsdl-toolchain:glibc-jammy

FROM ${TOOLCHAIN_IMAGE} AS toolchain

FROM ubuntu:jammy

ARG LLVM_MAJOR=22
ARG UBUNTU_CODENAME=jammy
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        ca-certificates gnupg wget \
    && rm -rf /var/lib/apt/lists/*

RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key \
      | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/${UBUNTU_CODENAME}/ llvm-toolchain-${UBUNTU_CODENAME}-${LLVM_MAJOR} main" \
      > /etc/apt/sources.list.d/llvm.list

RUN wget -qO- https://apt.kitware.com/keys/kitware-archive-latest.asc \
      | gpg --dearmor -o /usr/share/keyrings/kitware.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/kitware.gpg] https://apt.kitware.com/ubuntu/ ${UBUNTU_CODENAME} main" \
      > /etc/apt/sources.list.d/kitware.list

# clang and lld only. The LLVM libraries come from the toolchain image above,
# so llvm-${LLVM_MAJOR}-dev and its siblings would only supply a second, and
# differently configured, LLVM to link against by accident.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        clang-${LLVM_MAJOR} \
        lld-${LLVM_MAJOR} \
        cmake ninja-build \
        git python3 gzip file \
        dpkg-dev lintian \
    && rm -rf /var/lib/apt/lists/*

COPY --from=toolchain /opt/llvm-dsdl-toolchain /opt/llvm-dsdl-toolchain

# CMAKE_PREFIX_PATH points only at our prefix. clang-22 brings apt.llvm.org's
# own libLLVM into /usr/lib/llvm-22 as its runtime; naming ours explicitly keeps
# find_package(LLVM) off it.
ENV LLVM_DIR=/opt/llvm-dsdl-toolchain/lib/cmake/llvm \
    MLIR_DIR=/opt/llvm-dsdl-toolchain/lib/cmake/mlir \
    CMAKE_PREFIX_PATH=/opt/llvm-dsdl-toolchain \
    PATH=/opt/llvm-dsdl-toolchain/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CC=clang-22 \
    CXX=clang++-22

WORKDIR /src
