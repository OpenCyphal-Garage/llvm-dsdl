{
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
    "C_Cpp.intelliSenseEngine": "disabled",
    "cSpell.language": "en-GB,en-US",
    "cSpell.ignoreRegExpList": [
        "Compiler_Defines"
    ],
    "cSpell.patterns": [
        {
            "name": "Compiler_Defines",
            "pattern": "/-D[a-zA-Z_][a-zA-Z0-9_]*/g"
        }
    ],
    "cSpell.words": [
        "Aliasability",
        "appendable",
        "asan",
        "autosar",
        "BITLENGTHSET",
        "bugprone",
        "CEMITTER",
        "CODEGEN",
        "cppcoreguidelines",
        "CPPEMITTER",
        "cstdint",
        "ctest",
        "Cyphal",
        "Dafny",
        "deciamperes",
        "decivolts",
        "Depfiles",
        "deser",
        "deserialisation",
        "desynchronization",
        "dsdl",
        "dsdlc",
        "dsdld",
        "emitc",
        "fsanitize",
        "ifndef",
        "invertibility",
        "iwyu",
        "kirienko",
        "libudpard",
        "llms",
        "llvmdsdl",
        "metaserializable",
        "microcontroller",
        "minkowski",
        "mkdocs",
        "mlir",
        "nodiscard",
        "NOLINTNEXTLINE",
        "opencyphal",
        "pointee",
        "PYDSDL",
        "rustc",
        "RUSTEMITTER",
        "SERDES",
        "serialiser",
        "signless",
        "sortedness",
        "stdlib",
        "toolshed",
        "uavcan",
        "venv",
        "Werror"
    ]
}