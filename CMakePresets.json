{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/matrix/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release",
        "CMAKE_DEFAULT_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev-llvm-env",
      "displayName": "Development (LLVM_DIR/MLIR_DIR from environment)",
      "description": "Multi-config build using LLVM_DIR and MLIR_DIR from environment variables.",
      "inherits": "base",
      "cacheVariables": {
        "LLVM_DIR": "$env{LLVM_DIR}",
        "MLIR_DIR": "$env{MLIR_DIR}",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/matrix/dev-llvm-env/install"
      }
    },
    {
      "name": "dev-homebrew",
      "displayName": "Development (macOS Homebrew LLVM)",
      "description": "Multi-config build with LLVM/MLIR from /opt/homebrew/opt/llvm.",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "LLVM_DIR": "/opt/homebrew/opt/llvm/lib/cmake/llvm",
        "MLIR_DIR": "/opt/homebrew/opt/llvm/lib/cmake/mlir",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/matrix/dev-homebrew/install"
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Multi-config CI preset with automatic LLVM/MLIR discovery from environment/system paths.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/matrix/ci/install"
      }
    },
    {
      "name": "ci-asan",
      "displayName": "CI (ASan/UBSan)",
      "description": "CI preset that instruments every target with ASan and UBSan. Clang-only; build the Debug configuration so NDEBUG is absent and assert() guards fire beside the sanitizer.",
      "inherits": "ci",
      "binaryDir": "${sourceDir}/build/matrix/ci-asan",
      "cacheVariables": {
        "LLVMDSDL_ENABLE_SANITIZERS": "address,undefined",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/matrix/ci-asan/install"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-dev-llvm-env",
      "displayName": "Build (dev-llvm-env)",
      "configurePreset": "dev-llvm-env"
    },
    {
      "name": "build-dev-homebrew",
      "displayName": "Build (dev-homebrew)",
      "configurePreset": "dev-homebrew"
    },
    {
      "name": "build-ci",
      "displayName": "Build (ci)",
      "configurePreset": "ci",
      "configuration": "Debug"
    },
    {
      "name": "build-ci-asan",
      "displayName": "Build (ci-asan, Debug)",
      "configurePreset": "ci-asan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "configuration": "Debug",
      "execution": {
        "noTestsAction": "error",
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-dev-llvm-env-t0",
      "displayName": "Test (dev-llvm-env, tier 0)",
      "inherits": "test-base",
      "configurePreset": "dev-llvm-env",
      "filter": {
        "include": {
          "label": "t0"
        }
      }
    },
    {
      "name": "test-dev-llvm-env-full",
      "displayName": "Test (dev-llvm-env, every tier)",
      "inherits": "test-base",
      "configurePreset": "dev-llvm-env"
    },
    {
      "name": "test-dev-homebrew-t0",
      "displayName": "Test (dev-homebrew, tier 0)",
      "inherits": "test-base",
      "configurePreset": "dev-homebrew",
      "filter": {
        "include": {
          "label": "t0"
        }
      }
    },
    {
      "name": "test-dev-homebrew-full",
      "displayName": "Test (dev-homebrew, every tier)",
      "inherits": "test-base",
      "configurePreset": "dev-homebrew"
    },
    {
      "name": "test-ci-t0",
      "displayName": "Test (ci, tier 0)",
      "inherits": "test-base",
      "configurePreset": "ci",
      "filter": {
        "include": {
          "label": "t0"
        }
      }
    },
    {
      "name": "test-ci-full",
      "displayName": "Test (ci, every tier)",
      "inherits": "test-base",
      "configurePreset": "ci"
    },
    {
      "name": "test-ci-asan-full",
      "displayName": "Test (ci-asan, every tier under sanitizers)",
      "inherits": "test-base",
      "configurePreset": "ci-asan"
    }
  ],
  "workflowPresets": [
    {
      "name": "matrix-dev-llvm-env",
      "displayName": "Workflow (matrix dev-llvm-env)",
      "description": "Configure, build, and run tier 0 and then every tier.",
      "steps": [
        {
          "type": "configure",
          "name": "dev-llvm-env"
        },
        {
          "type": "build",
          "name": "build-dev-llvm-env"
        },
        {
          "type": "test",
          "name": "test-dev-llvm-env-t0"
        },
        {
          "type": "test",
          "name": "test-dev-llvm-env-full"
        }
      ]
    },
    {
      "name": "matrix-dev-homebrew",
      "displayName": "Workflow (matrix dev-homebrew)",
      "description": "Configure, build, and run tier 0 and then every tier.",
      "steps": [
        {
          "type": "configure",
          "name": "dev-homebrew"
        },
        {
          "type": "build",
          "name": "build-dev-homebrew"
        },
        {
          "type": "test",
          "name": "test-dev-homebrew-t0"
        },
        {
          "type": "test",
          "name": "test-dev-homebrew-full"
        }
      ]
    },
    {
      "name": "matrix-ci",
      "displayName": "Workflow (matrix ci)",
      "description": "Configure, build, and run tier 0 and then every tier.",
      "steps": [
        {
          "type": "configure",
          "name": "ci"
        },
        {
          "type": "build",
          "name": "build-ci"
        },
        {
          "type": "test",
          "name": "test-ci-t0"
        },
        {
          "type": "test",
          "name": "test-ci-full"
        }
      ]
    }
  ]
}
