# Generic end-effector ("hand") command.
# A tool adapter can map these channels to any physical interface.

uint8 MODE_DISABLED = 0
uint8 MODE_POSITION = 1
uint8 MODE_FORCE    = 2
uint8 MODE_VELOCITY = 3
uint8 MODE_CUSTOM   = 255

uint8 mode
float16[<=8] analog
bool[<=16] digital
uint8[<=32] vendor_specific_payload

@sealed
